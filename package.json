{
  "name": "glm-token-usage",
  "displayName": "GLM Token Usage",
  "description": "监控智谱 AI (BigModel) API Key 的使用量，在状态栏显示 Token 剩余百分比和重置时间",
  "version": "0.0.2",
  "publisher": "showlotus",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/showlotus/glm-usage"
  },
  "license": "MIT",
  "homepage": "https://github.com/showlotus/glm-usage#readme",
  "bugs": {
    "url": "https://github.com/showlotus/glm-usage/issues"
  },
  "keywords": [
    "GLM",
    "智谱AI",
    "BigModel",
    "API Monitor",
    "Token Usage"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "glmUsage.setKey",
        "title": "GLM Usage: Set API Key"
      },
      {
        "command": "glmUsage.refresh",
        "title": "GLM Usage: Refresh Usage"
      },
      {
        "command": "glmUsage.deleteKey",
        "title": "GLM Usage: Delete API Key"
      },
      {
        "command": "glmUsage.showUsageDetails",
        "title": "GLM Usage: Show Usage Details"
      }
    ],
    "configuration": {
      "title": "GLM Usage",
      "properties": {
        "glmUsage.statusBarTemplate": {
          "type": "string",
          "default": "GLM: 每 5 小时 - ${HOURLY_PERCENT}% | 每周 - ${WEEKLY_PERCENT}%",
          "description": "状态栏显示模板。可用变量：${HOURLY_PERCENT}、${WEEKLY_PERCENT}、${MCP_PERCENT}、${HOURLY_RESET}、${WEEKLY_RESET}、${MCP_RESET}、${HOURLY_BAR}、${WEEKLY_BAR}、${MCP_BAR}",
          "order": 1
        },
        "glmUsage.apiKey": {
          "type": "string",
          "default": "",
          "description": "GLM API Key（支持 Settings Sync 跨设备同步）",
          "order": 0
        },
        "glmUsage.refreshInterval": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "自动刷新间隔（分钟）"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "sharp": "^0.34.5",
    "typescript": "^5.3.0"
  }
}
